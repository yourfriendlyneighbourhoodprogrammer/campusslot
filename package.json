{
  "name": "campusslot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "start": "node server/index.js",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "seed": "node server/seed.js",
    "demo": "node server/demo.js",
    "format": "prettier --write \"server/*.js\" \"api/*.js\" \"client/src/*.{js,jsx,css}\" \"tests/*.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
